{
  "name": "footnote",
  "version": "0.1.0",
  "description": "The AI answer engine that pays its sources, via PayPal.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx scripts/e2e.ts",
    "demo": "MIN_PAYOUT_CENTS=10 tsx src/server.ts",
    "smoke:paypal": "tsx scripts/paypal-smoke.ts",
    "near:setup": "tsx scripts/near-setup.ts",
    "near:e2e": "tsx scripts/near-e2e.ts",
    "near:contract": "cd contracts/royalty-receipts && cargo build --release --target wasm32-unknown-unknown",
    "near:contract:test": "cd contracts/royalty-receipts && cargo test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "hono": "^4.13.16",
    "near-api-js": "^7.4.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
