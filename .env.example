# --- PayPal (sandbox) ---  https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id of a sandbox webhook pointing at <PUBLIC_URL>/api/webhooks/paypal
# (events PAYMENT.PAYOUTS-ITEM.*). Without it Footnote polls Payouts instead.
PAYPAL_WEBHOOK_ID=

# --- LLM (one of) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# FOOTNOTE_MODEL=claude-sonnet-5-5
# WEB_SEARCH=on            # Anthropic server-side web search (off = fetch_url only)

# --- App ---
PORT=3000
PUBLIC_URL=http://localhost:3000
MIN_PAYOUT_CENTS=100       # aggregate micro-royalties per payee until >= this
MAX_FEE_CENTS=100
MIN_FEE_CENTS=25
MIN_SCORE=0.15             # sources scoring below this are dropped
ESCROW_TTL_DAYS=30

# --- Hosted demo (see render.yaml) ---
# WELCOME_CREDITS_CENTS=150   # free starting credits for new sessions
# DAILY_ANSWER_CAP=150        # global cap on answers per 24h
# GEMINI_API_KEY=             # alternative LLM provider (set LLM_PROVIDER=gemini to force); SERPER_API_KEY enables web search for Gemini/OpenAI
# VULTR_API_KEY=              # Vultr Serverless Inference (OpenAI-compatible); VULTR_MODEL to pick the model
